# Application Runtime, URL & Port
NODE_ENV="production"
APP_URL="https://app-sanjay.indiacybercafe.com"
PORT="3000"

# Persistent storage path for SQLite database (platform.db) & uploaded files
# On Hostinger, point this to a persistent directory outside ephemeral build folders if needed
STORAGE_DIR="./storage"

# Firebase Project & Admin SDK (Server-Side)
FIREBASE_PROJECT_ID="sanjay-vaishya-app"
FIREBASE_DATABASE_URL="https://sanjay-vaishya-app-default-rtdb.firebaseio.com"
# JSON string or absolute file path of Firebase service account for full Admin SDK RTDB/Auth access
# Never commit service account credentials or expose them in frontend code
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Signed HttpOnly cookie secret (minimum 32 characters recommended in production)
SESSION_SECRET=""

# Razorpay Payment Gateway (Server-Side Only - Never Expose Secret Keys)
# Payments remain safely disabled until all three variables are configured
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

