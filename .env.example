# Application URL & Port
APP_URL="http://localhost:3000"
PORT="3000"

# Firebase Project & Admin SDK (Server-Side)
FIREBASE_PROJECT_ID="sanjay-vaishya-app"
FIREBASE_DATABASE_URL="https://sanjay-vaishya-app-default-rtdb.firebaseio.com"
# Optional: JSON string of Firebase service account for full Admin SDK RTDB/Auth access on VPS/Hostinger
# Never commit service account credentials or expose them in frontend code
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Signed HttpOnly cookie secret (used for private file attachment streaming after Firebase verification)
SESSION_SECRET=""

# Razorpay Payment Gateway (Server-Side Only - Never Expose Secret Keys)
# Payments remain safely disabled until all three variables are configured
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional Gemini API Key (if AI features are configured later)
GEMINI_API_KEY=""
