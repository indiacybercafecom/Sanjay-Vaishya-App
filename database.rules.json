{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'active') || (root.child('users').child(auth.uid).child('role').val() === 'project_manager' && root.child('users').child(auth.uid).child('status').val() === 'active'))",
        "profile": {
          ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'active'))",
          ".validate": "newData.hasChildren(['name', 'email'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 180"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "company": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "emailVerified": {
            ".validate": "newData.isBoolean()"
          }
        },
        "role": {
          ".write": "auth != null && ((!data.exists() && auth.uid === $uid && newData.val() === 'client') || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'active'))",
          ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'developer' || newData.val() === 'designer' || newData.val() === 'project_manager' || newData.val() === 'admin')"
        },
        "status": {
          ".write": "auth != null && ((!data.exists() && auth.uid === $uid && newData.val() === 'active') || (root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'active'))",
          ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'disabled')"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists() && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
